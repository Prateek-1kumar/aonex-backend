# LLM provider — uses OpenAI-compatible client. Point OPENAI_BASE_URL at Groq for
# cheaper/faster inference; the same OpenAIProvider talks to both.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_MODEL=llama-3.3-70b-versatile

# Per-tier model overrides (preferred when set). The two-tier router picks LIGHT
# for easy gap-fills (≤3 missing fields + JSON-LD present) and HEAVY otherwise.
GROQ_MODEL_GAP_FILL_LIGHT=llama-3.1-8b-instant
GROQ_MODEL_GAP_FILL_HEAVY=llama-3.3-70b-versatile
GROQ_MODEL_VISION=llama-3.2-90b-vision-preview
GROQ_MODEL_CLASSIFIER=llama-3.1-8b-instant
