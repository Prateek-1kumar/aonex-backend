{
  "name": "@aonex/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "bun test",
    "dev": "bun --env-file=../../.env run --hot src/index.ts",
    "start": "bun --env-file=../../.env run src/index.ts",
    "seed:source-priority": "bun --env-file=../../.env run scripts/seed-source-priority.ts",
    "seed:enrichment-catalog": "bun --env-file=../../.env run scripts/seed-enrichment-catalog.ts",
    "backfill:scores": "bun --env-file=../../.env run scripts/backfill-completeness-scores.ts",
    "bootstrap:channels": "bun --env-file=../../.env run scripts/bootstrap-channels.ts",
    "replay:dlq": "bun --env-file=../../.env run scripts/replay-dlq.ts",
    "product:debug": "bun --env-file=../../.env run scripts/product-debug.ts",
    "backfill:catalog": "bun --env-file=../../.env run scripts/backfill-catalog.ts",
    "validate:backfill": "bun --env-file=../../.env run scripts/validate-backfill.ts",
    "spot-check": "bun --env-file=../../.env run scripts/spot-check.ts"
  },
  "dependencies": {
    "@aonex/types": "workspace:*",
    "@aonex/lib-utils": "workspace:*",
    "@aonex/db": "workspace:*",
    "@aonex/archetypes": "workspace:*",
    "@aonex/taxonomy-classifier": "workspace:*",
    "@aonex/taxonomy-validator": "workspace:*",
    "@aonex/catalog-service": "workspace:*",
    "@aonex/catalog-enrichment": "workspace:*",
    "@aonex/catalog-event-outbox": "workspace:*",
    "@aonex/catalog-source-adapters": "workspace:*",
    "@aonex/connector-gateway": "workspace:*",
    "@aonex/audit": "workspace:*",
    "@aonex/ingestion-link-fetcher": "workspace:*",
    "@aonex/ingestion-llm-extractor": "workspace:*",
    "@aonex/ingestion-field-extractor": "workspace:*",
    "@aonex/ingestion-enrichment": "workspace:*",
    "@aonex/ingestion-semantic-mapper": "workspace:*",
    "@aonex/ingestion-policy-engine": "workspace:*",
    "@aonex/ingestion-structured": "workspace:*",
    "@aonex/ingestion-deduplicator": "workspace:*",
    "@aonex/ingestion-spine": "workspace:*",
    "@aonex/link-adapter": "workspace:*",
    "@aonex/per-site-parsers": "workspace:*",
    "@aonex/calibration": "workspace:*",
    "@aonex/drift-detector": "workspace:*",
    "bullmq": "^5.34.5",
    "ioredis": "^5.4.2",
    "drizzle-orm": "^0.36.4",
    "pino": "^9.5.0"
  }
}
