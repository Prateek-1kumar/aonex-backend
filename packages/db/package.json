{
  "name": "@aonex/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./client": "./src/client.ts",
    "./testing": "./src/testing/index.ts"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "migrate": "node-pg-migrate --envPath ../../.env",
    "migrate:up": "node-pg-migrate --envPath ../../.env up",
    "migrate:down": "node-pg-migrate --envPath ../../.env down",
    "migrate:redo": "node-pg-migrate --envPath ../../.env redo",
    "migrate:create": "node-pg-migrate --envPath ../../.env -j sql create",
    "studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@aonex/types": "workspace:*",
    "drizzle-orm": "^0.36.4",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/pg": "^8.11.10",
    "drizzle-kit": "^0.30.0",
    "node-pg-migrate": "^8.0.4"
  }
}
